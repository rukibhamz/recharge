# Supabase (API — server only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Optional: direct Postgres URL for npm run db:migrate
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
# DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase (Web — Vite exposes VITE_* to the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Production API (required on Vercel — Express does not run on static deploy)
# Leave empty in Vite `npm run dev` (proxies /api → localhost:3001).
# When serving built files via XAMPP, leave empty too — the web app auto-uses http://localhost:3001.
# On Vercel: VITE_API_URL=https://your-api-host.example.com
VITE_API_URL=
# Public web origin (no trailing slash). Used for magic-link redirects in production.
VITE_APP_URL=https://your-app.vercel.app

# Comma-separated browser origins allowed to call the API.
# Local Vite + XAMPP loopback are also allowed automatically.
CORS_ORIGIN=http://localhost:5173,http://localhost,http://127.0.0.1

# LLM provider chain (live questions first; banks are fallbacks only)
LLM_PROVIDER_ORDER=gemini,ollama
LLM_PERSONALITY_QUESTIONS=true
LLM_BURNOUT_QUESTIONS=true
LLM_RECOMMENDATIONS=true

# Google Gemini (cloud — tried first)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-latest
GEMINI_MIN_INTERVAL_MS=4000
GEMINI_MAX_RETRIES=2
GEMINI_CIRCUIT_BREAKER_MS=120000

# When Gemini fails (429 / circuit open), use Supabase question bank + local scoring (default on)
LLM_ASSESSMENT_BANK_FALLBACK=true

# Self-improving RAG loop: store anonymized patterns from tests + coach chats and inject them into prompts
LLM_KNOWLEDGE_LOOP=true

# Ollama (local fallback — https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=aiengine-qwen3:latest
OLLAMA_TIMEOUT_MS=120000

# Optional: bank-only mode (zero Gemini calls per assessment — good for free tier / quota limits)
# LLM_PERSONALITY_QUESTIONS=false
# LLM_BURNOUT_QUESTIONS=false
# LLM_RECOMMENDATIONS=false
GEMINI_PERSONALITY_QUESTIONS=true
GEMINI_BURNOUT_QUESTIONS=true
GEMINI_RECOMMENDATIONS=true

# API server
PORT=3001
# Comma-separated production URL(s), no trailing slash. Preview deploys: set CORS_VERCEL_PREVIEWS=1 on the API host.
CORS_ORIGIN=http://localhost:5173
# CORS_VERCEL_PREVIEWS=1

# Platform admin dashboard (/admin) — comma-separated emails that may access admin
ADMIN_EMAILS=you@example.com

# Optional SMTP (fallback if Admin → Settings → Email is empty)
# Prefer configuring SMTP in the admin panel; these env vars work as a backup.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_NAME=Recharge
# SMTP_FROM_EMAIL=recharge@thedigitalerrand.com

# Optional
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX=10
POSTHOG_KEY=
